# Generated secrets belong in .maos/.env (0600), never in Git.
COMPOSE_PROJECT_NAME=multi-agent-os-core
MAOS_UID=1000
MAOS_GID=1000
MAOS_API_PORT=8000
POSTGRES_DB=maos
POSTGRES_USER=maos
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=
APP_NAME=Multi-Agent OS
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REDACTION_ENABLED=true
REDIS_URL=redis://redis:6379/0
LLM_PROVIDER=ollama
# Set an already installed model. Initialization never downloads weights.
LLM_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1024
# Opt in: maos_examples.text_review (same setting for API and worker).
MAOS_EXTENSION_MODULES=
WORKER_HEARTBEAT_SECONDS=10
WORKER_LEASE_SECONDS=60
WORKER_POLL_SECONDS=1
WORKER_CONCURRENCY=1
MAX_WORKFLOW_NODES=32
MAX_PROVIDER_CALLS=16
MAX_INPUT_BYTES=65536
MAX_NODE_OUTPUT_BYTES=65536
MAX_RUN_BYTES=1048576
MAX_EVENT_PAYLOAD_BYTES=4096
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
READINESS_TIMEOUT_SECONDS=2
METRICS_ENABLED=true
METRICS_ROUTE_ENABLED=false
METRICS_MAX_PATH_LABEL_LENGTH=120
MAOS_API_URL=http://api:8000
MAOS_AUTH_FILE=/cli/auth.json
